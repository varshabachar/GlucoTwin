# Copy this file to  .streamlit/secrets.toml  and put your real key in it.
# .streamlit/secrets.toml is gitignored and must NEVER be committed - this repo is public.
# On Streamlit Community Cloud, do not upload a file: paste these lines into
#   Manage app -> Settings -> Secrets
# GlucoTwin runs fine with no key at all; the natural-language meal parser is simply hidden.

ANTHROPIC_API_KEY = "sk-ant-..."
